{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{customer churn/static/**,customer churn/models/**,customer churn/churn.db,customer churn/public/**,static/**,public/**,churn.db}",
      "excludeFiles": "{**/.venv/**,**/venv/**,redist/**,licenses/**,readmes/**,**/*.exe,**/*.dll,**/data/*.csv,**/test*.py,**/train.py,**/generate_data.py}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!static|favicon\\.ico).*)",
      "destination": "/api/index.py"
    }
  ]
}
