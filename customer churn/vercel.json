{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{customer churn/static/**,static/**}",
      "excludeFiles": "{**/.venv/**,**/venv/**,redist/**,licenses/**,readmes/**,**/*.exe,**/*.dll,**/data/*.csv,**/test*.py,**/train.py,**/generate_data.py}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
