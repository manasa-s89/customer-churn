{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{.venv/**,**/__pycache__/**,**/*.pyc,**/test_*.py,**/*_test.py,**/tests/**,**/testdata/**,cloudflared.exe}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
