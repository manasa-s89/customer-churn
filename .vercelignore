# ==============================================================================
# Vercel Deployment Ignore Configuration
# Prevents development artifacts, large binaries, virtualenvs, and data from bundle
# ==============================================================================

# Virtual Environments (Local environment is 711+ MB)
.venv/
venv/
ENV/
env/
**/.venv/
**/venv/
**/ENV/
**/env/

# Python Cache and Compiled Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
**/__pycache__/
**/*.py[cod]

# Large Binaries & Windows Installers
cloudflared.exe
**/cloudflared.exe
redist/
licenses/
readmes/
*.exe
*.dll
**/*.exe
**/*.dll

# Duplicate nested API directory
customer churn/api/

# Offline datasets & raw data (0.9 MB)
customer churn/data/
**/data/*.csv
**/*.csv

# Development & Offline Scripts (not needed by FastAPI runtime)
**/train.py
**/generate_data.py
**/fast_seed.py
**/seed_customers.py
**/evaluate_pipeline.py
**/inspect_db.py
**/inspect_model.py
**/check_dates.py
**/requirements-dev.txt

# Test Suites & Test Runners
**/run_all_tests.py
**/run_tests.py
**/test_*.py
**/tests/**

# Container & Shell Scripts
**/Dockerfile
**/docker-compose.yml
**/start_app.bat

# Node / JS modules, logs, and Vercel artifacts
**/node_modules/
**/*.log
.vercel/

# Version Control & IDE
.git/
.github/
.vscode/
.idea/
.env*
**/.env*

