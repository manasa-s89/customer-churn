# ==============================================================================
# Vercel Deployment Ignore Configuration
# Prevents development artifacts, large binaries, and duplicate functions
# ==============================================================================

# Virtual Environments (Local environment is 711+ MB)
.venv/
venv/
ENV/
env/

# Python Cache and Compiled Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Large Binaries & Windows Installers
cloudflared.exe
redist/
licenses/
readmes/
*.exe
*.dll

# Duplicate nested API directory
customer churn/api/

# Development & Offline Scripts (not needed by FastAPI runtime)
**/train.py
**/generate_data.py
**/fast_seed.py
**/seed_customers.py
**/evaluate_pipeline.py
**/inspect_db.py
**/inspect_model.py
**/check_dates.py
**/requirements-dev.txt

# Test Suites & Test Runners
**/run_all_tests.py
**/run_tests.py
**/test_*.py
**/tests/**

# Container & Shell Scripts
**/Dockerfile
**/docker-compose.yml
**/start_app.bat

# Version Control & IDE
.git/
.github/
.vscode/
.idea/
